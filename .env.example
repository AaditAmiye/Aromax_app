# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Device Configuration:
# "local" = physical ESP32 at http://192.168.6.155 (via browser or server bridge)
# "cloud" = Firebase Realtime Database command architecture
# "mock"  = Simulated hardware responses for offline development
VITE_DEVICE_MODE="local"
VITE_ESP32_HOST="http://192.168.6.155"

# Firebase Configuration (Real Realtime Database)
VITE_FIREBASE_API_KEY="AIzaSyBtmBnzYjhTLqaj3A-QWnpcyFy82kgGOcg"
VITE_FIREBASE_AUTH_DOMAIN="aromaxaitest-default-rtdb.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://aromaxaitest-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="aromaxaitest-default-rtdb"
VITE_FIREBASE_STORAGE_BUCKET="aromaxaitest-default-rtdb.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
